# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for SEO metadata / canonical links)
NEXT_PUBLIC_SITE_URL=https://example.org

# Server-side only. When set, /api/apply forwards validated applications here
# (e.g. a Google Apps Script web app, CRM webhook, or your own API).
# When empty, the registration form runs in clearly-labelled DEMO MODE
# and nothing is stored.
APPLICATIONS_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header.
APPLICATIONS_WEBHOOK_SECRET=
